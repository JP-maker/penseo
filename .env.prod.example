# À copier en « .env » SUR LE SERVEUR uniquement, puis à remplir. Ne jamais le versionner.
DOMAIN=penseo.fr
ACME_EMAIL=contact@penseo.fr

POSTGRES_DB=penseo
POSTGRES_USER=penseo
# Génère-le : openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# Génère-la : echo "base64:$(openssl rand -base64 32)"
# Ne la change plus ensuite : elle protège les sessions.
APP_KEY=
