# Image de PRODUCTION de Penséo : un seul conteneur qui sert le site Angular compilé et l'API Laravel,
# avec HTTPS automatique (FrankenPHP = serveur Caddy + PHP). Contexte de build : la racine du dépôt.

# 1. Frontend : compile Angular
FROM node:22-alpine AS web
ARG APP_VERSION=dev
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Écrit le numéro de version dans le pied de page du site (voir core/app-info.ts)
RUN sed -i "s/version: '[^']*'/version: '${APP_VERSION}'/" src/app/core/app-info.ts \
 && grep -q "version: '${APP_VERSION}'" src/app/core/app-info.ts
RUN npm run build

# 2. Backend : dépendances PHP sans les outils de développement
FROM composer:2 AS vendor
WORKDIR /app
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY backend/ ./
RUN composer dump-autoload --no-dev --optimize --no-scripts

# 3. Image finale
FROM dunglas/frankenphp:1-php8.4-alpine
LABEL org.opencontainers.image.source="https://github.com/JP-maker/penseo"
RUN install-php-extensions pdo_pgsql opcache
WORKDIR /app
COPY --from=vendor /app /app
COPY --from=web /app/dist/frontend/browser /srv/web
COPY deploy/Caddyfile /etc/frankenphp/Caddyfile
COPY deploy/entrypoint.sh /usr/local/bin/penseo-entrypoint
RUN chmod +x /usr/local/bin/penseo-entrypoint \
 && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
 && chmod -R a+rwX storage bootstrap/cache

ENV APP_ENV=production
ENTRYPOINT ["penseo-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
